// A live HTML page as a Slint element. The Rust side (mb_slint::HtmlView)
// renders the page into `frame` and handles `tapped`: where the tap was, as
// fractions of the element's width and height, so a page shown scaled down
// still gets its own coordinates.
export component HtmlView inherits Rectangle {
    in property <image> frame;
    callback tapped(float, float);
    clip: true;
    Image {
        source: root.frame;
        width: 100%;
        height: 100%;
        image-fit: fill;
    }
    TouchArea {
        clicked => {
            root.tapped(self.mouse-x / self.width, self.mouse-y / self.height);
        }
    }
}
